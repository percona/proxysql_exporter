#!/bin/sh

set -e

# creating proxysql_exporter user if it isn't already there
if ! getent passwd proxysql_exporter >/dev/null; then
    useradd \
        --system \
        --no-create-home \
        --shell /sbin/nologin \
        --comment "Prometheus exporter for ProxySQL metrics" \
        proxysql_exporter >/dev/null
fi

systemctl --system daemon-reload >/dev/null || true

exit 0
